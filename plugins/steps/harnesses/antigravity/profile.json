{
  "key": "antigravity",
  "label": "Antigravity",
  "out": "harnesses/antigravity/agents/{name}.md",
  "format": "md",
  "h1": true,
  "vars": {
    "write_tool": "replace_file_content",
    "exec_tool": "run_command"
  },
  "toolStyle": "list",
  "tools": {
    "none": [
      "view_file",
      "grep_search",
      "run_command"
    ],
    "report": [
      "view_file",
      "grep_search",
      "run_command",
      "replace_file_content"
    ],
    "code": [
      "view_file",
      "grep_search",
      "run_command",
      "replace_file_content"
    ]
  },
  "fields": [
    "name",
    "description",
    "tools",
    "subagent",
    "mainAgent",
    "model",
    "commandExecutionPolicy"
  ],
  "static": {
    "subagent": true,
    "mainAgent": false,
    "commandExecutionPolicy": "eager"
  },
  "bundle": {
    "root": "harnesses/antigravity",
    "pluginJson": {
      "name": "steps",
      "description": "Run a roadmap phase by phase under separation of duties for Antigravity CLI: the steps orchestrator skill, its five stage skills, and the nine role subagents."
    },
    "copies": [
      { "from": "skills/steps/SKILL.md", "to": "skills/steps/SKILL.md" },
      { "from": "skills/steps-plan/SKILL.md", "to": "skills/steps-plan/SKILL.md" },
      { "from": "skills/steps-review/SKILL.md", "to": "skills/steps-review/SKILL.md" },
      { "from": "skills/steps-implement/SKILL.md", "to": "skills/steps-implement/SKILL.md" },
      { "from": "skills/steps-verify/SKILL.md", "to": "skills/steps-verify/SKILL.md" },
      { "from": "skills/steps-fix/SKILL.md", "to": "skills/steps-fix/SKILL.md" },
      { "from": "MODEL_ROUTING.md", "to": "MODEL_ROUTING.md" }
    ]
  },
  "models": {
    "repo-scout": {
      "model": "flash"
    },
    "steps-planner": {
      "model": "flash"
    },
    "steps-reconciler": {
      "model": "flash"
    },
    "steps-plan-reviewer": {
      "model": "flash"
    },
    "steps-impl-reviewer": {
      "model": "flash"
    },
    "steps-implementer": {
      "model": "flash"
    },
    "steps-architect-pro": {
      "model": "flash"
    },
    "step-verifier": {
      "model": "flash"
    },
    "steps-fixer": {
      "model": "flash"
    }
  }
}
